# Optional model overrides — provider naming moves faster than this codebase
# STATEMENT_MODEL defaults to claude-opus-5. Sonnet is safe for statements —
# they tie out arithmetically, so a bad read is rejected whoever produced it —
# and costs about a fifth as much. Receipts keep two models, because a
# photograph has no such check.
# STATEMENT_MODEL=claude-sonnet-5
# STATEMENT_MODEL_FALLBACK=claude-opus-5
# VISION_MODEL_A=claude-sonnet-5
# VISION_MODEL_B=gpt-5.6
# VISION_MODEL_TIEBREAK=claude-opus-5
# STATEMENT_MODEL=claude-opus-5
